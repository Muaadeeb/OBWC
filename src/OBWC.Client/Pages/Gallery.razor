@page "/gallery"
@inject ClubApi Club
@inject ApiOrigin Origin

<PageTitle>Gallery · OBWC</PageTitle>
<h1>Gallery</h1>
<p class="lede">Photos of OBWC games at public events. An admin keeps this gallery. @_count</p>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (!string.IsNullOrEmpty(_error))
{
    <MudAlert Severity="Severity.Error">@_error</MudAlert>
}
else if (_gallery is null || _gallery.Photos.Count == 0)
{
    <MudAlert Severity="Severity.Info">No public-event photos have been added yet.</MudAlert>
}
else
{
    <div class="link-grid">
        @foreach (var photo in _gallery.Photos)
        {
            <figure class="catalog-card">
                <img class="gallery-photo" src="@Origin.Absolute(photo.Url)" alt="@photo.Caption" />
                <figcaption>
                    <strong>@photo.Caption</strong><br />
                    @photo.PublicEventName<br />
                    <span class="mud-text-secondary">@ClubTime.FormatDateTime(AsUtc(photo.CreatedAtUtc))</span>
                </figcaption>
            </figure>
        }
    </div>
}

@code {
    private GalleryListDto? _gallery;
    private bool _loading = true;
    private string? _error;
    private string _count = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _gallery = await Club.GetGalleryAsync();
            if (_gallery is not null)
                _count = $"{_gallery.Count} of {_gallery.MaxPhotos} used.";
        }
        catch (ClubApiException ex) { _error = ex.Message; }
        finally { _loading = false; }
    }

    private static DateTimeOffset AsUtc(DateTime value) =>
        new(DateTime.SpecifyKind(value, DateTimeKind.Utc), TimeSpan.Zero);
}
