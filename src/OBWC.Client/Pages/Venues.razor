@page "/venues"
@inject ClubApi Club
@inject ApiOrigin Origin

<PageTitle>Venues · OBWC</PageTitle>
<h1>Venues</h1>
<p class="lede">Places the club uses. The list is kept by a GM or an admin.</p>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (!string.IsNullOrEmpty(_error))
{
    <MudAlert Severity="Severity.Error">@_error</MudAlert>
}
else if (_venues.Count == 0)
{
    <MudAlert Severity="Severity.Info">No venues have been entered yet.</MudAlert>
}

@foreach (var venue in _venues)
{
    <MudPaper Class="pa-3 mb-3" Outlined="true">
        <h2>@venue.Name</h2>
        @if (!string.IsNullOrWhiteSpace(venue.Address))
        {
            <p>@venue.Address</p>
        }
        @if (!string.IsNullOrWhiteSpace(venue.Description))
        {
            <p style="white-space:pre-wrap">@venue.Description</p>
        }
        @if (venue.HasInsidePhoto || venue.HasOutsidePhoto)
        {
            <div class="link-grid">
                @if (venue.HasInsidePhoto)
                {
                    <PhotoSlot Src="@Origin.Absolute(venue.InsidePhotoUrl)" Label="Inside" Alt="@($"{venue.Name} inside")" />
                }
                @if (venue.HasOutsidePhoto)
                {
                    <PhotoSlot Src="@Origin.Absolute(venue.OutsidePhotoUrl)" Label="Outside" Alt="@($"{venue.Name} outside")" />
                }
            </div>
        }
    </MudPaper>
}

@code {
    private List<VenueDto> _venues = [];
    private bool _loading = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try { _venues = (await Club.GetVenuesAsync()).ToList(); }
        catch (ClubApiException ex) { _error = ex.Message; }
        finally { _loading = false; }
    }
}
