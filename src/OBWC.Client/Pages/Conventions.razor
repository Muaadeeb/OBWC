@page "/conventions"
@inject ClubApi Club

<PageTitle>Conventions · OBWC</PageTitle>
<h1>Conventions</h1>
<p class="lede">Conventions our members attend. Dates are calendar dates.</p>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (!string.IsNullOrEmpty(_error))
{
    <MudAlert Severity="Severity.Error">@_error</MudAlert>
}
else if (_items.Count == 0)
{
    <MudAlert Severity="Severity.Info">No conventions have been entered yet.</MudAlert>
}

@foreach (var item in _items)
{
    <MudPaper Class="pa-3 mb-2" Outlined="true">
        <h2>@item.Name</h2>
        @if (!string.IsNullOrWhiteSpace(item.Description))
        {
            <p style="white-space:pre-wrap">@item.Description</p>
        }
        @if (DateLabel(item) is string dates)
        {
            <p>@dates</p>
        }
        @if (!string.IsNullOrWhiteSpace(item.LocationText))
        {
            <p>@item.LocationText</p>
        }
        @if (!string.IsNullOrWhiteSpace(item.WebsiteUrl))
        {
            <MudLink Href="@item.WebsiteUrl" Target="_blank">@item.WebsiteUrl</MudLink>
        }
    </MudPaper>
}

@code {
    private List<ConventionDto> _items = [];
    private bool _loading = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try { _items = (await Club.GetConventionsAsync()).ToList(); }
        catch (ClubApiException ex) { _error = ex.Message; }
        finally { _loading = false; }
    }

    private static string? DateLabel(ConventionDto item)
    {
        if (item.StartsOn is null && item.EndsOn is null)
            return null;
        if (item.StartsOn is DateOnly start && item.EndsOn is DateOnly end && end != start)
            return $"{start:MMMM d, yyyy} – {end:MMMM d, yyyy}";
        var day = item.StartsOn ?? item.EndsOn;
        return day?.ToString("MMMM d, yyyy");
    }
}
