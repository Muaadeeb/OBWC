@page "/groups"
@inject ClubApi Club

<PageTitle>Other Area Gaming Groups · OBWC</PageTitle>
<h1>Other Area Gaming Groups</h1>
<p class="lede">Groups the club wants visitors to know about.</p>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (!string.IsNullOrEmpty(_error))
{
    <MudAlert Severity="Severity.Error">@_error</MudAlert>
}
else if (_groups.Count == 0)
{
    <MudAlert Severity="Severity.Info">No groups have been entered yet.</MudAlert>
}
else
{
    <MudExpansionPanels>
        @foreach (var group in _groups)
        {
            <MudExpansionPanel Text="@group.Name">
                @if (!string.IsNullOrWhiteSpace(group.GameFocus))
                {
                    <p><strong>Games:</strong> @group.GameFocus</p>
                }
                @if (!string.IsNullOrWhiteSpace(group.Description))
                {
                    <p style="white-space:pre-wrap">@group.Description</p>
                }
                @if (!string.IsNullOrWhiteSpace(group.Contact))
                {
                    <p>@group.Contact</p>
                }
                @if (!string.IsNullOrWhiteSpace(group.WebsiteUrl))
                {
                    <MudLink Href="@group.WebsiteUrl" Target="_blank">@group.WebsiteUrl</MudLink>
                }
            </MudExpansionPanel>
        }
    </MudExpansionPanels>
}

@code {
    private List<GroupDto> _groups = [];
    private bool _loading = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try { _groups = (await Club.GetGroupsAsync()).ToList(); }
        catch (ClubApiException ex) { _error = ex.Message; }
        finally { _loading = false; }
    }
}
