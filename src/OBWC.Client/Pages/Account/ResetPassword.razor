@page "/account/reset-password"
@inject AuthApi Auth
@inject NavigationManager Nav

<PageTitle>Reset password · OBWC</PageTitle>
<h1>Reset password</h1>
<MudTextField @bind-Value="_password" Label="New password" InputType="InputType.Password" />
<MudButton Class="mt-2" Variant="Variant.Filled" Color="Color.Primary" OnClick="Submit">Save password</MudButton>
@if (!string.IsNullOrEmpty(_message)) { <MudAlert Severity="@(_ok ? Severity.Success : Severity.Error)" Class="mt-3">@_message</MudAlert> }

@code {
    private string _password = "", _message = "";
    private bool _ok;

    private async Task Submit()
    {
        var query = new Uri(Nav.Uri).Query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries);
        string userId = "", token = "";
        foreach (var part in query)
        {
            var pair = part.Split('=', 2);
            var key = Uri.UnescapeDataString(pair[0]);
            var value = pair.Length > 1 ? Uri.UnescapeDataString(pair[1]) : "";
            if (key == "userId") userId = value;
            if (key == "token") token = value;
        }
        var error = await Auth.ResetAsync(new ResetPasswordRequest { UserId = userId, Token = token, NewPassword = _password });
        _ok = error is null;
        _message = error ?? "Password updated. You can sign in.";
    }
}
