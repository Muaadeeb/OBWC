@page "/account/forgot-password"
@inject AuthApi Auth

<PageTitle>Forgot password · OBWC</PageTitle>
<h1>Forgot password</h1>
<MudTextField @bind-Value="_email" Label="Email" />
<MudButton Class="mt-2" Variant="Variant.Filled" Color="Color.Primary" OnClick="Submit">Send reset link</MudButton>
@if (_sent) { <MudAlert Severity="Severity.Success" Class="mt-3">If that account exists, a password email is on its way. In local development the link is in the API log when SMTP is not configured.</MudAlert> }

@code {
    private string _email = "";
    private bool _sent;
    private async Task Submit()
    {
        await Auth.ForgotAsync(_email);
        _sent = true;
    }
}
