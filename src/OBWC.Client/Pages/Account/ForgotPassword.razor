@page "/account/forgot-password"
@inject AuthApi Auth

<PageTitle>Forgot password · OBWC</PageTitle>
<MudPaper Class="pa-4 account-card" Outlined="true">
    <h1>Forgot password</h1>
    <p class="lede">If the account exists, a reset link is sent. In local development, when mail is not configured, the link is on Dev mail.</p>
    <MudTextField @bind-Value="_email" Label="Email" InputType="InputType.Email" Variant="Variant.Outlined" />
    @if (!string.IsNullOrEmpty(_message))
    {
        <MudAlert Severity="@(_error ? Severity.Error : Severity.Success)" Class="mt-3">@_message</MudAlert>
    }
    <MudButton Class="mt-3" Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick="Submit">Send reset link</MudButton>
</MudPaper>

@code {
    private string _email = "";
    private string _message = "";
    private bool _error;
    private bool _busy;

    private async Task Submit()
    {
        if (!FormChecks.IsEmail(_email))
        {
            _error = true;
            _message = "Enter the email on the account.";
            return;
        }

        _busy = true;
        try
        {
            var error = await Auth.ForgotAsync(_email.Trim());
            _error = error is not null;
            _message = error ?? "If that account exists, a password email is on its way. In local development the link is on the Dev mail page and in the API log when SMTP is not configured.";
        }
        finally
        {
            _busy = false;
        }
    }
}
