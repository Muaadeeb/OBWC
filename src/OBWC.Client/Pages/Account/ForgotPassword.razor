@page "/account/forgot-password"
@inject AuthApi Auth
@inject IConfiguration Configuration

<PageTitle>Forgot password · OBWC</PageTitle>
<MudPaper Class="pa-4 account-card" Outlined="true">
    <h1>Forgot password</h1>
    <p class="lede">
        If the account exists, a reset link is sent.
        @if (_devMail)
        {
            <text> In local development, when mail is not configured, the link is on <MudLink Href="/dev/mail">Dev mail</MudLink>.</text>
        }
    </p>
    <MudTextField @bind-Value="_email" Label="Email" InputType="InputType.Email" Variant="Variant.Outlined" />
    @if (!string.IsNullOrEmpty(_message))
    {
        <MudAlert Severity="@(_error ? Severity.Error : Severity.Success)" Class="mt-3">
            @_message
            @if (!_error && _devMail)
            {
                <text> In local development the link is on <MudLink Href="/dev/mail">Dev mail</MudLink> and in the API log when SMTP is not configured.</text>
            }
        </MudAlert>
    }
    <MudButton Class="mt-3" Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick="Submit">Send reset link</MudButton>
    <div class="mt-3">
        <MudLink Href="/account/login">Sign in</MudLink>
    </div>
</MudPaper>

@code {
    private string _email = "";
    private string _message = "";
    private bool _error;
    private bool _busy;
    private bool _devMail;

    protected override void OnInitialized() =>
        _devMail = Configuration.GetValue("DevTools:Enabled", false);

    private async Task Submit()
    {
        if (!FormChecks.IsEmail(_email))
        {
            _error = true;
            _message = "Enter the email on the account.";
            return;
        }

        _busy = true;
        try
        {
            var error = await Auth.ForgotAsync(_email.Trim());
            _error = error is not null;
            _message = error ?? "If that account exists, a password email is on its way.";
        }
        finally
        {
            _busy = false;
        }
    }
}
