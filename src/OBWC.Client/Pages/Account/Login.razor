@page "/account/login"
@inject AuthApi Auth
@inject NavigationManager Nav

<PageTitle>Member sign in · OBWC</PageTitle>
<MudPaper Class="pa-4" Outlined="true" Style="max-width:28rem">
    <h1>Member sign in</h1>
    <MudTextField @bind-Value="_email" Label="Email" InputType="InputType.Email" />
    <MudTextField @bind-Value="_password" Label="Password" InputType="InputType.Password" />
    @if (!string.IsNullOrEmpty(_error)) { <MudAlert Severity="Severity.Error" Class="mt-2">@_error</MudAlert> }
    <MudButton Class="mt-3" Variant="Variant.Filled" Color="Color.Primary" OnClick="Submit">Sign in</MudButton>
    <div class="mt-3">
        <MudLink Href="/account/register">Create an account</MudLink>
        · <MudLink Href="/account/forgot-password">Forgot password</MudLink>
    </div>
</MudPaper>

@code {
    private string _email = "", _password = "", _error = "";
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }

    private async Task Submit()
    {
        _error = await Auth.LoginAsync(new LoginRequest { Email = _email, Password = _password }) ?? "";
        if (string.IsNullOrEmpty(_error))
            Nav.NavigateTo(Safe(ReturnUrl));
    }

    private static string Safe(string? value) =>
        !string.IsNullOrEmpty(value) && value.StartsWith('/') && !value.StartsWith("//", StringComparison.Ordinal) ? value : "/";
}
