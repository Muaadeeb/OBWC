@inject ClubApi Club
@inject IJSRuntime Js
@inject ISnackbar Snackbar

<h1>@Heading</h1>
<p class="lede">Files an admin has posted for this section. Members-only files stay off the public list.</p>
@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (!string.IsNullOrEmpty(_error))
{
    <MudAlert Severity="Severity.Error">@_error</MudAlert>
}
else if (_docs.Count == 0)
{
    <MudAlert Severity="Severity.Info">No @Heading.ToLowerInvariant() file is available to you yet.</MudAlert>
}
else
{
    <MudList T="ClubDocumentDto">
        @foreach (var doc in _docs)
        {
            <MudListItem>
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="flex-wrap">
                    <div>
                        <strong>@doc.Title</strong>
                        <div class="mud-text-secondary">@doc.FileName · @VisibilityLabel(doc.Visibility) · @ClubTime.FormatDateTime(AsUtc(doc.CreatedAtUtc))</div>
                        @if (!string.IsNullOrWhiteSpace(doc.Description))
                        {
                            <div>@doc.Description</div>
                        }
                    </div>
                    <MudSpacer />
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="() => Download(doc)">Download</MudButton>
                </MudStack>
            </MudListItem>
        }
    </MudList>
}

@code {
    [Parameter, EditorRequired] public DocumentCategory Category { get; set; }
    [Parameter, EditorRequired] public string Heading { get; set; } = "";

    private List<ClubDocumentDto> _docs = [];
    private string? _error;
    private bool _loading = true;

    protected override async Task OnParametersSetAsync() => await Reload();

    private async Task Reload()
    {
        _loading = true;
        try { _docs = (await Club.GetDocumentsAsync(Category)).ToList(); _error = null; }
        catch (ClubApiException ex) { _error = ex.Message; }
        finally { _loading = false; }
    }

    private async Task Download(ClubDocumentDto doc)
    {
        try
        {
            var (bytes, name) = await Club.DownloadDocumentAsync(doc.Id);
            await Js.InvokeVoidAsync("obwcDownload", name, bytes);
        }
        catch (ClubApiException ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private static string VisibilityLabel(DocumentVisibility visibility) =>
        visibility == DocumentVisibility.Public ? "Public" : "Members only";

    private static DateTimeOffset AsUtc(DateTime value) =>
        new(DateTime.SpecifyKind(value, DateTimeKind.Utc), TimeSpan.Zero);
}
