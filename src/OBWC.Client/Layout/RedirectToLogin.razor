@inject NavigationManager Navigation

@code {
    protected override void OnInitialized()
    {
        var relative = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);
        if (!relative.StartsWith('/') || relative.StartsWith("//", StringComparison.Ordinal))
            relative = "/";
        Navigation.NavigateTo($"/account/login?returnUrl={Uri.EscapeDataString(relative)}");
    }
}
