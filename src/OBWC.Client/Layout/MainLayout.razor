@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject AuthApi AuthApi
@inject IJSRuntime Js
@inject IConfiguration Configuration

<a class="skip-link" href="#main">Skip to content</a>

<MudThemeProvider Theme="ObwcThemes.Theme" IsDarkMode="_dark" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Fixed="true" Class="club-appbar">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" aria-label="Open the menu" OnClick="@(() => _open = !_open)" />
        <div class="club-mark appbar-mark" aria-hidden="true">OBWC</div>
        <MudText Typo="Typo.h6" Class="ml-2 appbar-title">
            <span class="appbar-title-full">Omaha Beach Wargaming Club</span>
            <span class="appbar-title-short">OBWC</span>
        </MudText>
        <MudSpacer />
        <div class="appbar-actions">
            <MudIconButton Icon="@(_dark ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)" Color="Color.Inherit" OnClick="ToggleTheme" aria-label="@(_dark ? "Switch to light mode" : "Switch to dark mode")" />
            <div class="appbar-account">
                <AuthorizeView>
                    <Authorized>
                        <MudButton Href="/account/profile" Color="Color.Inherit" aria-label="Your profile">@context.User.Identity?.Name</MudButton>
                        <MudButton Color="Color.Inherit" OnClick="Logout">Sign out</MudButton>
                    </Authorized>
                    <NotAuthorized>
                        <MudButton Href="/account/login" Variant="Variant.Outlined" Color="Color.Inherit">Member sign in</MudButton>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>
    </MudAppBar>
    <MudDrawer @bind-Open="_open" ClipMode="DrawerClipMode.Always" Elevation="0" Variant="DrawerVariant.Responsive" aria-label="Site">
        <MudNavMenu>
            <MudText Typo="Typo.overline" Class="px-4 pt-3">Public</MudText>
            <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">Home</MudNavLink>
            <MudNavLink Href="/about" Icon="@Icons.Material.Filled.Info">About Us</MudNavLink>
            <MudNavLink Href="/next-event" Icon="@Icons.Material.Filled.Newspaper">Next Event</MudNavLink>
            <MudNavLink Href="/schedule" Icon="@Icons.Material.Filled.CalendarMonth">Game Schedule</MudNavLink>
            <MudNavLink Href="/gallery" Icon="@Icons.Material.Filled.PhotoLibrary">Gallery</MudNavLink>
            <MudNavLink Href="/rules" Icon="@Icons.Material.Filled.MenuBook">Games &amp; Rules</MudNavLink>
            <MudNavLink Href="/stores" Icon="@Icons.Material.Filled.Store">Game Stores</MudNavLink>
            <MudNavLink Href="/venues" Icon="@Icons.Material.Filled.Place">Venues</MudNavLink>
            <MudNavLink Href="/nuke-con" Icon="@Icons.Material.Filled.EmojiEvents">Nuke-Con</MudNavLink>
            <MudNavLink Href="/groups" Icon="@Icons.Material.Filled.Groups">Area Groups</MudNavLink>
            <MudNavLink Href="/conventions" Icon="@Icons.Material.Filled.Festival">Conventions</MudNavLink>
            <MudNavLink Href="/contact" Icon="@Icons.Material.Filled.Email">Contact Us</MudNavLink>
            <MudNavLink Href="/documents" Icon="@Icons.Material.Filled.Description">Documents</MudNavLink>
            <AuthorizeView Roles="Member,Admin,SuperAdmin">
                <Authorized>
                    <MudText Typo="Typo.overline" Class="px-4 pt-3">Members</MudText>
                    <MudNavLink Href="/my-schedule" Icon="@Icons.Material.Filled.EventAvailable">My schedule</MudNavLink>
                    <MudNavLink Href="/members/constitution" Icon="@Icons.Material.Filled.Gavel">Constitution</MudNavLink>
                    <MudNavLink Href="/members/budget" Icon="@Icons.Material.Filled.AccountBalance">Budget</MudNavLink>
                    <MudNavLink Href="/members/minutes" Icon="@Icons.Material.Filled.Article">Minutes</MudNavLink>
                </Authorized>
            </AuthorizeView>
            <AuthorizeView Roles="GM,Admin,SuperAdmin">
                <Authorized>
                    <MudText Typo="Typo.overline" Class="px-4 pt-3">Maintain</MudText>
                    <MudNavLink Href="/admin/venues" Icon="@Icons.Material.Filled.EditLocation">Venues</MudNavLink>
                </Authorized>
            </AuthorizeView>
            <AuthorizeView Roles="Admin,SuperAdmin">
                <Authorized>
                    <MudText Typo="Typo.overline" Class="px-4 pt-3">Admin</MudText>
                    <MudNavLink Href="/admin/officers" Icon="@Icons.Material.Filled.Badge">Officers</MudNavLink>
                    <MudNavLink Href="/admin/gallery" Icon="@Icons.Material.Filled.PhotoLibrary">Gallery</MudNavLink>
                    <MudNavLink Href="/admin/conventions" Icon="@Icons.Material.Filled.Festival">Conventions</MudNavLink>
                    <MudNavLink Href="/admin/groups" Icon="@Icons.Material.Filled.Groups">Area groups</MudNavLink>
                    <MudNavLink Href="/admin/documents" Icon="@Icons.Material.Filled.UploadFile">Documents</MudNavLink>
                    <MudNavLink Href="/admin/users" Icon="@Icons.Material.Filled.ManageAccounts">Users &amp; roles</MudNavLink>
                </Authorized>
            </AuthorizeView>
            @if (_devMail)
            {
                <MudText Typo="Typo.overline" Class="px-4 pt-3">Development</MudText>
                <MudNavLink Href="/dev/mail" Icon="@Icons.Material.Filled.MarkEmailUnread">Dev mail</MudNavLink>
            }
            <div class="drawer-account">
                <MudDivider Class="my-2" />
                <AuthorizeView>
                    <Authorized>
                        <MudNavLink Href="/account/profile" Icon="@Icons.Material.Filled.Person">@context.User.Identity?.Name</MudNavLink>
                        <MudNavLink Href="/" Icon="@Icons.Material.Filled.Logout" OnClick="Logout">Sign out</MudNavLink>
                    </Authorized>
                    <NotAuthorized>
                        <MudNavLink Href="/account/login" Icon="@Icons.Material.Filled.Login">Member sign in</MudNavLink>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </MudNavMenu>
    </MudDrawer>
    <MudMainContent>
        <div class="terrain-stripe"></div>
        <MudContainer MaxWidth="MaxWidth.Large" Class="page-wrap" id="main">
            @Body
        </MudContainer>
        <footer class="club-footer">
            <div>
                <strong>Omaha Beach Wargaming Club</strong>
                <div>Historical and miniature gaming.</div>
            </div>
            <nav aria-label="Footer">
                <MudLink Href="/about">About</MudLink>
                <MudLink Href="/schedule">Schedule</MudLink>
                <MudLink Href="/rules">Games &amp; rules</MudLink>
                <MudLink Href="/contact">Contact</MudLink>
            </nav>
        </footer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _open;
    private bool _dark;
    private bool _devMail;

    protected override void OnInitialized() =>
        _devMail = Configuration.GetValue("DevTools:Enabled", false);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;
        var wide = await Js.InvokeAsync<bool>("obwcViewport.wide");
        var stored = await Js.InvokeAsync<string?>("obwcStorage.get", "obwc.theme");
        _open = wide;
        _dark = stored == "dark";
        if (_dark)
            await Js.InvokeVoidAsync("obwcTheme.set", true);
        StateHasChanged();
    }

    private async Task ToggleTheme()
    {
        _dark = !_dark;
        await Js.InvokeVoidAsync("obwcStorage.set", "obwc.theme", _dark ? "dark" : "light");
        await Js.InvokeVoidAsync("obwcTheme.set", _dark);
    }

    private async Task Logout()
    {
        await AuthApi.LogoutAsync();
        Navigation.NavigateTo("/");
    }
}
