<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Edit game day</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.caption" Class="mud-text-secondary mb-2 d-block">Times stay on Reschedule. Games keep using this place.</MudText>
        <MudForm @ref="_form">
        <MudGrid>
            <MudItem xs="12">
                <MudTextField @bind-Value="_title" Label="Title" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" md="6">
                <VenueField @bind-Value="_venue" @bind-VenueId="_venueId" Venues="Venues" ListedChanged="OnVenueListed"
                            Validation="@(new Func<string, string?>(ValidateVenue))" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_address" @bind-Value:after="SyncPlace" Label="Address" Variant="Variant.Outlined" Margin="Margin.Dense"
                              ReadOnly="@(_venueId is not null)" HelperText="@(_venueId is null ? null : "Address comes from the venues list.")"
                              Validation="@(new Func<string, string?>(ValidateAddress))" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="_online" Label="Discord / online link" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="_locationNotes" Label="Location notes" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="2" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="_notes" Label="Notes" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="2" />
            </MudItem>
        </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Notes { get; set; }
    [Parameter] public string? Venue { get; set; }
    [Parameter] public Guid? VenueId { get; set; }
    [Parameter] public IReadOnlyList<VenueDto> Venues { get; set; } = [];
    [Parameter] public string? Address { get; set; }
    [Parameter] public string? OnlineLink { get; set; }
    [Parameter] public string? LocationNotes { get; set; }

    private string _title = "";
    private string _notes = "";
    private string _venue = "";
    private Guid? _venueId;
    private string _address = "";
    private string _online = "";
    private string _locationNotes = "";
    private MudForm _form = null!;
    private bool _attempted;

    protected override void OnParametersSet()
    {
        _title = Title ?? "";
        _notes = Notes ?? "";
        _venue = Venue ?? "";
        _venueId = VenueId;
        _address = Address ?? "";
        _online = OnlineLink ?? "";
        _locationNotes = LocationNotes ?? "";
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task OnVenueListed(VenueDto? venue)
    {
        if (venue is not null)
            _address = venue.Address ?? "";
        await SyncPlace();
    }

    private async Task SyncPlace()
    {
        if (_attempted)
            await _form.ValidateAsync();
    }

    private string? ValidateVenue(string venue) => PlaceError(venue, _address);

    private string? ValidateAddress(string address) => PlaceError(_venue, address);

    private static string? PlaceError(string? venue, string? address) =>
        string.IsNullOrWhiteSpace(venue) && string.IsNullOrWhiteSpace(address)
            ? "A game day needs a venue or an address."
            : null;

    private async Task SubmitAsync()
    {
        _attempted = true;
        await _form.ValidateAsync();
        if (!_form.IsValid)
            return;

        MudDialog.Close(DialogResult.Ok(new Result(
            string.IsNullOrWhiteSpace(_title) ? null : _title.Trim(),
            string.IsNullOrWhiteSpace(_notes) ? null : _notes.Trim(),
            _venueId,
            _venue.Trim(),
            string.IsNullOrWhiteSpace(_address) ? null : _address.Trim(),
            string.IsNullOrWhiteSpace(_online) ? null : _online.Trim(),
            string.IsNullOrWhiteSpace(_locationNotes) ? null : _locationNotes.Trim())));
    }

    public sealed record Result(
        string? Title,
        string? Notes,
        Guid? VenueId,
        string? Venue,
        string? Address,
        string? OnlineLink,
        string? LocationNotes);
}
