@inject ScheduleApi Schedule

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_event is null)
{
    <MudAlert Severity="Severity.Info">No upcoming game is on the schedule.</MudAlert>
}
else
{
    <article class="broadsheet">
        <header>
            <p class="eyebrow">@(_event.ScheduleKind == "GameDay" ? "Next game day" : "Next game")</p>
            <h2>@(string.IsNullOrWhiteSpace(_event.Title) ? (_event.ScheduleKind == "GameDay" ? "Game day" : "Club game") : _event.Title)</h2>
        </header>
        <dl>
            <dt>Location</dt>
            <dd>
                @if (_event.VenueId is Guid)
                {
                    <PlaceLine VenueId="_event.VenueId" Venue="_event.Venue" Address="_event.Address" />
                    @if (!string.IsNullOrWhiteSpace(_event.LocationNotes))
                    {
                        <text> (@_event.LocationNotes)</text>
                    }
                }
                else
                {
                    @_event.LocationDisplay
                }
            </dd>
            <dt>Date/Time</dt>
            <dd>@ClubTime.FormatLongDate(_event.ScheduledAt) · @ClubTime.FormatTimeRange(_event.ScheduledAt, _event.EndsAt)</dd>
            <dt>Points of contact</dt>
            <dd>
                @if (!string.IsNullOrWhiteSpace(_event.HostName))
                {
                    @_event.HostName <span>(host) · Scheduled by @_event.OwnerDisplayName@(_event.OwnerIsGm ? " (GM)" : "")</span>
                }
                else
                {
                    @_event.OwnerDisplayName@(_event.OwnerIsGm ? " (GM)" : "")
                }
            </dd>
            <dt>Games</dt>
            <dd>
                @(_event.RuleSetName ?? "See the notes")
                @if (!string.IsNullOrWhiteSpace(_event.Notes))
                {
                    <span> — @_event.Notes</span>
                }
            </dd>
        </dl>
        @if (_event.IsCancelled)
        {
            <MudAlert Severity="Severity.Warning" Dense="true">Cancelled@(_event.CancellationReason is null ? "" : ": " + _event.CancellationReason)</MudAlert>
        }
        <MudButton Variant="Variant.Text" Href="/schedule" Class="mt-2">Open the schedule</MudButton>
    </article>
}

@code {
    private bool _loading = true;
    private CalendarEventDto? _event;

    protected override async Task OnInitializedAsync()
    {
        try { _event = await Schedule.GetNextAsync(); }
        catch (ClubApiException) { _event = null; }
        finally { _loading = false; }
    }
}
