@page "/schedule"
@inject ScheduleApi Schedule
@inject ClubApi Club
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject IJSRuntime Js

<PageTitle>Game Schedule · OBWC</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2 flex-wrap">
    <h1 class="mud-typography mud-typography-h4 mb-0">Game schedule</h1>
    <MudButton Class="ml-3" Size="Size.Small" Variant="Variant.Outlined" Href="/calendar" StartIcon="@Icons.Material.Filled.CalendarMonth">View calendar</MudButton>
    <MudSpacer />
    <AuthorizeView Roles="Member,Admin,SuperAdmin">
        <Authorized>
            <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="DownloadIcsAsync" StartIcon="@Icons.Material.Filled.Download">Download calendar .ics</MudButton>
            <MudButton Size="Size.Small" Variant="Variant.Text" Href="/my-schedule" StartIcon="@Icons.Material.Filled.EventAvailable">My schedule</MudButton>
        </Authorized>
    </AuthorizeView>
</MudStack>
<p class="lede">Public calendar of club games and game days. A game day is one place and time that can host several games. A game is one table a member runs. Times are Central Time (CT).</p>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Class="mb-3" />
}
else
{
    <MudStack Row="true" Class="mb-3 flex-wrap" Spacing="1">
        <MudSelect T="string" Value="_window" ValueChanged="ChangeWindow" Label="When" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:14rem">
            <MudSelectItem T="string" Value="@("upcoming")">Upcoming</MudSelectItem>
            @foreach (var month in _months)
            {
                <MudSelectItem T="string" Value="@month.Key">@month.Label</MudSelectItem>
            }
        </MudSelect>
        @foreach (var filter in Enum.GetValues<CalFilter>())
        {
            <MudChip T="string" Size="Size.Small" Color="@(_filter == filter ? Color.Primary : Color.Default)"
                     Variant="@(_filter == filter ? Variant.Filled : Variant.Outlined)" OnClick="() => _filter = filter">
                @FilterLabel(filter)
            </MudChip>
        }
        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@Visible.Count shown</MudChip>
    </MudStack>

    <AuthorizeView>
        <Authorized>
            <MudExpansionPanels Class="mb-4" Elevation="0">
                <MudExpansionPanel Text="Schedule a game">
                <MudForm @ref="_gameForm">
                <MudGrid>
                    <MudItem xs="12" md="3">
                        <MudDatePicker @bind-Date="_newDate" Label="First date" Variant="Variant.Outlined" Margin="Margin.Dense"
                                       Validation="@(new Func<DateTime?, string?>(ValidateGameDate))" />
                    </MudItem>
                    <MudItem xs="12" md="2">
                        <MudTimePicker @bind-Time="_newTime" Label="Start (CT)" Variant="Variant.Outlined" Margin="Margin.Dense" AmPm="true"
                                       Validation="@(new Func<TimeSpan?, string?>(ValidateGameStart))" />
                    </MudItem>
                    <MudItem xs="12" md="2"><MudTimePicker @bind-Time="_newEnd" Label="End (CT)" Variant="Variant.Outlined" Margin="Margin.Dense" AmPm="true" /></MudItem>
                    <MudItem xs="12" md="2"><MudNumericField T="int" @bind-Value="_weeks" Label="Weeks" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" Max="26" HelperText="1 = single night" /></MudItem>
                    <MudItem xs="12" md="3">
                        <MudTextField @bind-Value="_title" Label="Title" Variant="Variant.Outlined" Margin="Margin.Dense"
                                      Validation="@(new Func<string, string?>(ValidateGameTitle))" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudTextField @bind-Value="_host" Label="Host" Variant="Variant.Outlined" Margin="Margin.Dense"
                                      MaxLength="200" HelperText="Who is running this game." />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudTextField @bind-Value="_venue" @bind-Value:after="SyncGamePlace" Label="Venue" Variant="Variant.Outlined" Margin="Margin.Dense"
                                      Validation="@(new Func<string, string?>(ValidateGameVenue))" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudTextField @bind-Value="_address" @bind-Value:after="SyncGamePlace" Label="Address" Variant="Variant.Outlined" Margin="Margin.Dense"
                                      Validation="@(new Func<string, string?>(ValidateGameAddress))" />
                    </MudItem>
                    <MudItem xs="12" md="4"><MudTextField @bind-Value="_online" Label="Discord / online link" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                    <MudItem xs="12" md="6"><MudTextField @bind-Value="_notes" Label="Games / notes" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="2" /></MudItem>
                    <MudItem xs="12" md="3"><MudTextField @bind-Value="_locationNotes" Label="Location notes" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                    <MudItem xs="12" md="3"><MudNumericField T="int?" @bind-Value="_cap" Label="Player cap (Going)" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" Clearable="true" HelperText="Overflow → waitlist" /></MudItem>
                    <MudItem xs="12" md="4">
                        <RuleSetField @bind-Value="_ruleSetName" RuleSets="_ruleSets" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudCheckBox T="bool" @bind-Value="_published" Label="Publish to the public calendar" Color="Color.Primary" />
                        <MudCheckBox T="bool" @bind-Value="_allowRsvp" Label="Allow player RSVP" Color="Color.Secondary" />
                    </MudItem>
                    <MudItem xs="12" md="4" Class="d-flex align-center">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick="CreateAsync" StartIcon="@Icons.Material.Filled.Event">
                            @(_weeks > 1 ? $"Add {_weeks}-week series" : "Add to calendar")
                        </MudButton>
                    </MudItem>
                </MudGrid>
                </MudForm>
                @if (!string.IsNullOrEmpty(_formError))
                {
                    <MudAlert Severity="@(_membersOnlyNotice ? Severity.Warning : Severity.Error)" Dense="true" Class="mt-2">@_formError</MudAlert>
                }
                </MudExpansionPanel>
            </MudExpansionPanels>
            <MudExpansionPanels Class="mb-4" Elevation="0">
                <MudExpansionPanel Text="Schedule a game day">
                <MudText Typo="Typo.caption" Class="mud-text-secondary mb-2 d-block">One place and time. Members post games onto it afterwards. A weekly series repeats the day, not the games.</MudText>
                <MudForm @ref="_dayForm">
                <MudGrid>
                    <MudItem xs="12" md="3">
                        <MudDatePicker @bind-Date="_dayDate" Label="First date" Variant="Variant.Outlined" Margin="Margin.Dense"
                                       Validation="@(new Func<DateTime?, string?>(ValidateDayDate))" />
                    </MudItem>
                    <MudItem xs="12" md="2">
                        <MudTimePicker @bind-Time="_dayStart" @bind-Time:after="SyncDayTimes" Label="Start (CT)" Variant="Variant.Outlined" Margin="Margin.Dense" AmPm="true"
                                       Validation="@(new Func<TimeSpan?, string?>(ValidateDayStart))" />
                    </MudItem>
                    <MudItem xs="12" md="2">
                        <MudTimePicker @bind-Time="_dayEnd" @bind-Time:after="SyncDayTimes" Label="End (CT)" Variant="Variant.Outlined" Margin="Margin.Dense" AmPm="true"
                                       Validation="@(new Func<TimeSpan?, string?>(ValidateDayEnd))" />
                    </MudItem>
                    <MudItem xs="12" md="2"><MudNumericField T="int" @bind-Value="_dayWeeks" Label="Weeks" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" Max="26" HelperText="1 = one date" /></MudItem>
                    <MudItem xs="12" md="3">
                        <MudTextField @bind-Value="_dayTitle" Label="Title" Variant="Variant.Outlined" Margin="Margin.Dense"
                                      Validation="@(new Func<string, string?>(ValidateDayTitle))" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudTextField @bind-Value="_dayVenue" @bind-Value:after="SyncDayPlace" Label="Venue" Variant="Variant.Outlined" Margin="Margin.Dense"
                                      Validation="@(new Func<string, string?>(ValidateDayVenue))" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudTextField @bind-Value="_dayAddress" @bind-Value:after="SyncDayPlace" Label="Address" Variant="Variant.Outlined" Margin="Margin.Dense"
                                      Validation="@(new Func<string, string?>(ValidateDayAddress))" />
                    </MudItem>
                    <MudItem xs="12" md="4"><MudTextField @bind-Value="_dayOnline" Label="Discord / online link" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                    <MudItem xs="12" md="6"><MudTextField @bind-Value="_dayNotes" Label="Notes" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="2" /></MudItem>
                    <MudItem xs="12" md="3"><MudTextField @bind-Value="_dayLocationNotes" Label="Location notes" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                    <MudItem xs="12" md="3">
                        <MudCheckBox T="bool" @bind-Value="_dayPublished" Label="Publish to the public calendar" Color="Color.Primary" />
                    </MudItem>
                    <MudItem xs="12" md="4" Class="d-flex align-center">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick="CreateDayAsync" StartIcon="@Icons.Material.Filled.Event">
                            @(_dayWeeks > 1 ? $"Add {_dayWeeks}-week game day" : "Add game day")
                        </MudButton>
                    </MudItem>
                </MudGrid>
                </MudForm>
                @if (!string.IsNullOrEmpty(_dayFormError))
                {
                    <MudAlert Severity="@(_dayMembersOnly ? Severity.Warning : Severity.Error)" Dense="true" Class="mt-2">@_dayFormError</MudAlert>
                }
                </MudExpansionPanel>
            </MudExpansionPanels>
        </Authorized>
    </AuthorizeView>

    @if (!string.IsNullOrEmpty(_error))
    {
        <MudAlert Severity="Severity.Error">@_error</MudAlert>
    }
    else if (Visible.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Dense="true">Nothing on the schedule matches this view.</MudAlert>
    }
    else
    {
        @foreach (var row in Visible)
        {
            if (row.Day is GameDayDto day)
            {
                <MudPaper Class="pa-3 mb-2" Outlined="true" Style="@(day.IsCancelled ? "opacity:.75" : day.IsPublished ? null : "border-style:dashed")">
                    <MudStack Row="true" AlignItems="AlignItems.Start" Class="flex-wrap">
                        <MudStack Spacing="0" Style="min-width:10rem">
                            <MudText Typo="Typo.subtitle1"><strong>@ClubTime.FormatDate(day.ScheduledAt)</strong></MudText>
                            <MudText Typo="Typo.body2">@ClubTime.FormatTimeRange(day.ScheduledAt, day.EndsAt)</MudText>
                            <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Class="fit-chip">Game day</MudChip>
                            @if (day.IsCancelled) { <MudChip T="string" Size="Size.Small" Color="Color.Error" Class="fit-chip">Cancelled</MudChip> }
                            @if (!day.IsPublished) { <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="fit-chip">Draft</MudChip> }
                            @if (day.SeriesKey is not null) { <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="fit-chip">Series</MudChip> }
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@day.Games.Count @(day.Games.Count == 1 ? "game" : "games")</MudChip>
                        </MudStack>
                        <MudStack Spacing="1" Style="flex:1; min-width:14rem">
                            <MudText Typo="Typo.h6">@(string.IsNullOrWhiteSpace(day.Title) ? "Game day" : day.Title)</MudText>
                            <MudText Typo="Typo.caption">@day.Venue @(!string.IsNullOrWhiteSpace(day.Address) ? " · " + day.Address : "")</MudText>
                            @if (!string.IsNullOrWhiteSpace(day.OnlineLink))
                            {
                                <MudLink Href="@day.OnlineLink" Target="_blank">Online / Discord</MudLink>
                            }
                            @if (!string.IsNullOrWhiteSpace(day.LocationNotes))
                            {
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">@day.LocationNotes</MudText>
                            }
                            @if (!string.IsNullOrWhiteSpace(day.Notes))
                            {
                                <MudText Typo="Typo.body2" Style="white-space:pre-wrap">@day.Notes</MudText>
                            }
                            @if (day.IsCancelled && !string.IsNullOrWhiteSpace(day.CancellationReason))
                            {
                                <MudText Typo="Typo.caption" Color="Color.Error">@day.CancellationReason</MudText>
                            }
                            <MudText Typo="Typo.caption">Hosted by @day.OwnerDisplayName</MudText>
                            <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">Players going @day.PlayersGoing</MudChip>
                        </MudStack>
                        <MudStack Spacing="1" AlignItems="AlignItems.End">
                            @if (day.CanEdit && !day.IsCancelled)
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Text" Disabled="_busy" OnClick="() => PublishDayAsync(day)">@(day.IsPublished ? "Unpublish" : "Publish")</MudButton>
                                <MudButton Size="Size.Small" Variant="Variant.Text" Disabled="_busy" OnClick="() => EditDayAsync(day)">Edit game day…</MudButton>
                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Warning" Disabled="_busy" OnClick="() => RescheduleDayAsync(day)">Reschedule…</MudButton>
                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" Disabled="_busy" OnClick="() => CancelDayAsync(day)">Cancel game day…</MudButton>
                            }
                            <AuthorizeView Roles="Member,Admin,SuperAdmin">
                                <Authorized>
                                    @if (!day.IsCancelled)
                                    {
                                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick="() => AddGameAsync(day)">Add a game</MudButton>
                                    }
                                </Authorized>
                            </AuthorizeView>
                        </MudStack>
                    </MudStack>
                    @foreach (var game in day.Games)
                    {
                        <ScheduleGameCard Event="game" Busy="_busy" Nested="true" DayStart="day.ScheduledAt" DayEnd="day.EndsAt"
                                          Expanded="_expanded.Contains(game.Id)" Roster="RosterFor(game.Id)"
                                          OnToggleRoster="ToggleRosterAsync" OnPublish="PublishFromCard" OnEdit="EditAsync"
                                          OnReschedule="RescheduleAsync" OnCancel="CancelAsync" OnDetach="DetachAsync"
                                          OnSelfCheckIn="SelfCheckInAsync" OnRsvp="RsvpFromCard" OnManagerCheckIn="ManagerFromCard"
                                          OnChanged="ReloadAsync" />
                    }
                </MudPaper>
            }
            else if (row.Game is CalendarEventDto ev)
            {
                <ScheduleGameCard Event="ev" Busy="_busy" Expanded="_expanded.Contains(ev.Id)" Roster="RosterFor(ev.Id)"
                                  OnToggleRoster="ToggleRosterAsync" OnPublish="PublishFromCard" OnEdit="EditAsync"
                                  OnReschedule="RescheduleAsync" OnCancel="CancelAsync" OnDetach="DetachAsync"
                                  OnSelfCheckIn="SelfCheckInAsync" OnRsvp="RsvpFromCard" OnManagerCheckIn="ManagerFromCard"
                                  OnChanged="ReloadAsync" />
            }
        }
    }
}

@code {
    private enum CalFilter { Upcoming, Past, MyGoing, NeedsMyRsvp }

    private bool _loading = true;
    private bool _busy;
    private string? _error;
    private string? _formError;
    private string? _dayFormError;
    private bool _membersOnlyNotice;
    private bool _dayMembersOnly;
    private MudForm _gameForm = null!;
    private MudForm _dayForm = null!;
    private bool _gameAttempted;
    private bool _dayAttempted;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }
    private string _window = "upcoming";
    private CalFilter _filter = CalFilter.Upcoming;
    private List<CalendarEventDto> _events = [];
    private List<GameDayDto> _days = [];
    private List<RuleSetDto> _ruleSets = [];
    private readonly Dictionary<Guid, IReadOnlyList<RosterRowDto>> _rosters = [];
    private readonly HashSet<Guid> _expanded = [];
    private List<(string Key, string Label)> _months = [];

    private DateTime? _newDate = ClubTime.ClubToday().AddDays(7);
    private TimeSpan? _newTime = new TimeSpan(18, 0, 0);
    private TimeSpan? _newEnd = new TimeSpan(22, 0, 0);
    private int _weeks = 1;
    private string _title = "";
    private string _host = "";
    private string _venue = "";
    private string _address = "";
    private string _online = "";
    private string _notes = "";
    private string _locationNotes = "";
    private int? _cap;
    private string? _ruleSetName;
    private bool _published = true;
    private bool _allowRsvp = true;

    private DateTime? _dayDate = ClubTime.ClubToday().AddDays(7);
    private TimeSpan? _dayStart = new TimeSpan(10, 0, 0);
    private TimeSpan? _dayEnd = new TimeSpan(18, 0, 0);
    private int _dayWeeks = 1;
    private string _dayTitle = "";
    private string _dayVenue = "";
    private string _dayAddress = "";
    private string _dayOnline = "";
    private string _dayNotes = "";
    private string _dayLocationNotes = "";
    private bool _dayPublished = true;

    private sealed record ScheduleRow(DateTimeOffset Start, CalendarEventDto? Game, GameDayDto? Day);

    private List<ScheduleRow> Visible
    {
        get
        {
            var rows = new List<ScheduleRow>();
            foreach (var ev in _events)
            {
                if (ev.GameDayId is null && Matches(ev))
                    rows.Add(new ScheduleRow(ev.ScheduledAt, ev, null));
            }

            foreach (var day in _days)
            {
                if (MatchesDay(day))
                    rows.Add(new ScheduleRow(day.ScheduledAt, null, day));
            }

            rows.Sort((left, right) => left.Start.CompareTo(right.Start));
            return rows;
        }
    }

    private IReadOnlyList<RosterRowDto>? RosterFor(Guid id) =>
        _rosters.TryGetValue(id, out var roster) ? roster : null;

    protected override async Task OnInitializedAsync()
    {
        var today = ClubTime.ClubToday();
        _months = Enumerable.Range(0, 12).Select(index =>
        {
            var month = today.AddMonths(index);
            return ($"{month:yyyy-MM}", month.ToString("MMMM yyyy"));
        }).ToList();
        try
        {
            _ruleSets = (await Club.GetRuleSetsAsync()).ToList();
        }
        catch (ClubApiException)
        {
            _ruleSets = [];
        }
        await ReloadAsync();
    }

    private bool Matches(CalendarEventDto ev) => _filter switch
    {
        CalFilter.Past => ev.ScheduledAt < DateTimeOffset.UtcNow.AddHours(-6),
        CalFilter.MyGoing => ev.MyRsvp is SessionRsvpStatus.Going or SessionRsvpStatus.Waitlist,
        CalFilter.NeedsMyRsvp => !ev.IsCancelled && ev.AllowPlayerRsvp && ev.IsPublished && ev.ScheduledAt > DateTimeOffset.UtcNow && ev.MyRsvp == SessionRsvpStatus.Unknown,
        _ => ev.ScheduledAt >= DateTimeOffset.UtcNow.AddHours(-6) || _window != "upcoming"
    };

    private bool MatchesDay(GameDayDto day) => _filter switch
    {
        CalFilter.Past => day.ScheduledAt < DateTimeOffset.UtcNow.AddHours(-6),
        CalFilter.MyGoing => day.Games.Any(ev => ev.MyRsvp is SessionRsvpStatus.Going or SessionRsvpStatus.Waitlist),
        CalFilter.NeedsMyRsvp => day.Games.Any(ev => !ev.IsCancelled && ev.AllowPlayerRsvp && ev.IsPublished && ev.ScheduledAt > DateTimeOffset.UtcNow && ev.MyRsvp == SessionRsvpStatus.Unknown),
        _ => day.ScheduledAt >= DateTimeOffset.UtcNow.AddHours(-6) || _window != "upcoming"
    };

    private static string FilterLabel(CalFilter filter) => filter switch
    {
        CalFilter.Past => "Past",
        CalFilter.MyGoing => "My Going",
        CalFilter.NeedsMyRsvp => "Needs my RSVP",
        _ => "Upcoming"
    };

    private async Task ChangeWindow(string value)
    {
        _window = value;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            if (_window == "upcoming")
            {
                _events = (await Schedule.ListAsync()).ToList();
                _days = (await Schedule.ListGameDaysAsync()).ToList();
            }
            else
            {
                var parts = _window.Split('-');
                var year = int.Parse(parts[0]);
                var month = int.Parse(parts[1]);
                _events = (await Schedule.ListAsync(year, month)).ToList();
                _days = (await Schedule.ListGameDaysAsync(year, month)).ToList();
            }
        }
        catch (ClubApiException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task CreateAsync()
    {
        _formError = null;
        _membersOnlyNotice = false;
        if (!await CanScheduleAsync())
        {
            _formError = "Only members may schedule a game.";
            _membersOnlyNotice = true;
            return;
        }

        _gameAttempted = true;
        await _gameForm.ValidateAsync();
        if (!_gameForm.IsValid || _newDate is null || _newTime is null)
            return;

        var start = ClubTime.FromClubWallClock(_newDate.Value, _newTime.Value);
        DateTimeOffset? end = null;
        if (_newEnd is TimeSpan endTime)
        {
            var endDate = _newDate.Value.Date;
            if (endTime < _newTime.Value)
                endDate = endDate.AddDays(1);
            end = ClubTime.FromClubWallClock(endDate, endTime);
        }
        _busy = true;
        try
        {
            await Schedule.CreateAsync(new CreateSessionRequest
            {
                Title = _title.Trim(),
                ScheduledAt = start,
                EndsAt = end,
                Venue = Blank(_venue),
                Address = Blank(_address),
                OnlineLink = Blank(_online),
                Notes = Blank(_notes),
                LocationNotes = Blank(_locationNotes),
                PlayerCap = _cap,
                Weeks = _weeks,
                IsPublished = _published,
                AllowPlayerRsvp = _allowRsvp,
                RuleSetName = Blank(_ruleSetName ?? ""),
                HostName = Blank(_host)
            });
            Snackbar.Add(_weeks > 1 ? "Series added." : "Game added.", Severity.Success);
            _title = "";
            _host = "";
            await ReloadAsync();
        }
        catch (ClubApiException ex)
        {
            _formError = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RsvpAsync(Guid id, SessionRsvpStatus status)
    {
        _busy = true;
        try
        {
            var result = await Schedule.RsvpAsync(id, status);
            if (!string.IsNullOrWhiteSpace(result.Note))
                Snackbar.Add(result.Note, Severity.Info);
            await ReloadAsync();
        }
        catch (ClubApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally { _busy = false; }
    }

    private async Task SelfCheckInAsync(CalendarEventDto ev)
    {
        _busy = true;
        try
        {
            if (ev.IAmCheckedIn)
                await Schedule.UndoCheckInAsync(ev.Id, null);
            else
                await Schedule.CheckInAsync(ev.Id, null);
            await ReloadAsync();
        }
        catch (ClubApiException ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _busy = false; }
    }

    private async Task ManagerCheckInAsync(Guid id, string userId, bool undo)
    {
        _busy = true;
        try
        {
            if (undo)
                await Schedule.UndoCheckInAsync(id, userId);
            else
                await Schedule.CheckInAsync(id, userId);
            _rosters[id] = await Schedule.RosterAsync(id);
            await ReloadAsync();
        }
        catch (ClubApiException ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _busy = false; }
    }

    private async Task ToggleRosterAsync(Guid id)
    {
        if (!_expanded.Add(id))
        {
            _expanded.Remove(id);
            return;
        }
        try { _rosters[id] = await Schedule.RosterAsync(id); }
        catch (ClubApiException ex) { Snackbar.Add(ex.Message, Severity.Error); _expanded.Remove(id); }
    }

    private async Task PublishAsync(CalendarEventDto ev, bool published)
    {
        _busy = true;
        try { await Schedule.PublishAsync(ev.Id, published); await ReloadAsync(); }
        catch (ClubApiException ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _busy = false; }
    }

    private async Task EditAsync(CalendarEventDto ev)
    {
        var parameters = new DialogParameters
        {
            [nameof(EditEventDialog.Title)] = ev.Title,
            [nameof(EditEventDialog.Notes)] = ev.Notes,
