    private static string? ValidateGameTitle(string title) =>
        string.IsNullOrWhiteSpace(title) ? "Enter a title." : null;

    private string? ValidateGameDate(DateTime? date) =>
        date is null ? "Enter a date." : null;

    private string? ValidateGameStart(TimeSpan? start) =>
        start is null ? "Enter a start time." : null;

    private string? ValidateGameVenue(string venue) => GamePlaceError(venue, _address);

    private string? ValidateGameAddress(string address) => GamePlaceError(_venue, address);

    private static string? GamePlaceError(string? venue, string? address) =>
        string.IsNullOrWhiteSpace(venue) && string.IsNullOrWhiteSpace(address)
            ? "Add a venue or an address."
            : null;

    private static string? ValidateDayTitle(string title) =>
        string.IsNullOrWhiteSpace(title) ? "Enter a title." : null;

    private string? ValidateDayDate(DateTime? date) =>
        date is null ? "Enter a date." : null;

    private string? ValidateDayStart(TimeSpan? start) =>
        start is null ? "Enter a start time." : null;

    private string? ValidateDayEnd(TimeSpan? end)
    {
        if (end is null)
            return "Enter an end time.";
        if (_dayDate is null || _dayStart is null)
            return null;

        var start = ClubTime.FromClubWallClock(_dayDate.Value, _dayStart.Value);
        var endDate = _dayDate.Value.Date;
        if (end.Value <= _dayStart.Value)
            endDate = endDate.AddDays(1);
        var endAt = ClubTime.FromClubWallClock(endDate, end.Value);
        return endAt <= start ? "End time must be after the start time." : null;
    }

    private string? ValidateDayVenue(string venue) => DayPlaceError(venue, _dayAddress);

    private string? ValidateDayAddress(string address) => DayPlaceError(_dayVenue, address);

    private static string? DayPlaceError(string? venue, string? address) =>
        string.IsNullOrWhiteSpace(venue) && string.IsNullOrWhiteSpace(address)
            ? "A game day needs a venue or an address."
            : null;

    private async Task<bool> CanScheduleAsync()
    {
        if (AuthenticationState is null)
            return false;
        var state = await AuthenticationState;
        var user = state.User;
        return user.IsInRole(RoleNames.Member)
            || user.IsInRole(RoleNames.Admin)
            || user.IsInRole(RoleNames.SuperAdmin);
    }

    private static string? Blank(string value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

