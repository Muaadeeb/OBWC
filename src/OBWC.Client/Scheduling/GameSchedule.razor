    private async Task CreateDayAsync()
    {
        _dayFormError = null;
        _dayMembersOnly = false;
        if (!await CanScheduleAsync())
        {
            _dayFormError = "Only members may schedule a game.";
            _dayMembersOnly = true;
            return;
        }

        _dayAttempted = true;
        await _dayForm.ValidateAsync();
        if (!_dayForm.IsValid || _dayDate is null || _dayStart is null || _dayEnd is null)
            return;

        var start = ClubTime.FromClubWallClock(_dayDate.Value, _dayStart.Value);
        var endDate = _dayDate.Value.Date;
        if (_dayEnd.Value <= _dayStart.Value)
            endDate = endDate.AddDays(1);
        var end = ClubTime.FromClubWallClock(endDate, _dayEnd.Value);

        _busy = true;
        try
        {
            await Schedule.CreateGameDayAsync(new CreateGameDayRequest
            {
                Title = _dayTitle.Trim(),
                ScheduledAt = start,
                EndsAt = end,
                Venue = Blank(_dayVenue),
                Address = Blank(_dayAddress),
                OnlineLink = Blank(_dayOnline),
                Notes = Blank(_dayNotes),
                LocationNotes = Blank(_dayLocationNotes),
                Weeks = _dayWeeks,
                IsPublished = _dayPublished
            });
            Snackbar.Add(_dayWeeks > 1 ? "Game day series added." : "Game day added.", Severity.Success);
            _dayTitle = "";
            await ReloadAsync();
        }
        catch (ClubApiException ex)
        {
            _dayFormError = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

