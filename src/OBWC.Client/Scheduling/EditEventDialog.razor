<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Edit game</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form">
        <MudGrid>
            <MudItem xs="12">
                <MudTextField @bind-Value="_title" Label="Title" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="_host" Label="Host" Variant="Variant.Outlined" Margin="Margin.Dense"
                              MaxLength="200" HelperText="Who is running this game." />
            </MudItem>
            @if (!HidePlace)
            {
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_venue" Label="Venue" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_address" Label="Address" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_online" Label="Discord / online link" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
            }
            <MudItem xs="12" md="6">
                <MudNumericField T="int?" @bind-Value="_playerCap" Label="Player cap (Going)" Variant="Variant.Outlined"
                                 Margin="Margin.Dense" Min="1" Max="64" Clearable="true"
                                 HelperText="Overflow goes to the waitlist. Lowering the cap waitlists the newest Going replies."
                                 Validation="@(new Func<int?, string?>(ValidateCap))" />
            </MudItem>
            @if (HidePlace)
            {
                <MudItem xs="12">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">This game uses the game day's place and time window.</MudText>
                </MudItem>
            }
            else
            {
                <MudItem xs="12">
                    <MudTextField @bind-Value="_locationNotes" Label="Location notes" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="2" />
                </MudItem>
            }
            <MudItem xs="12">
                <MudTextField @bind-Value="_notes" Label="Notes" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="2" />
            </MudItem>
            <MudItem xs="12">
                <RuleSetField @bind-Value="_ruleSetName" RuleSets="RuleSets" />
            </MudItem>
        </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Notes { get; set; }
    [Parameter] public string? Venue { get; set; }
    [Parameter] public string? Address { get; set; }
    [Parameter] public string? OnlineLink { get; set; }
    [Parameter] public string? LocationNotes { get; set; }
    [Parameter] public int? PlayerCap { get; set; }
    [Parameter] public string? RuleSetName { get; set; }
    [Parameter] public string? HostName { get; set; }
    [Parameter] public IReadOnlyList<RuleSetDto> RuleSets { get; set; } = [];
    [Parameter] public bool HidePlace { get; set; }

    private string _title = "";
    private string _host = "";
    private string _notes = "";
    private string _venue = "";
    private string _address = "";
    private string _online = "";
    private string _locationNotes = "";
    private int? _playerCap;
    private string? _ruleSetName;
    private MudForm _form = null!;

    protected override void OnParametersSet()
    {
        _title = Title ?? "";
        _host = HostName ?? "";
        _notes = Notes ?? "";
        _venue = Venue ?? "";
        _address = Address ?? "";
        _online = OnlineLink ?? "";
        _locationNotes = LocationNotes ?? "";
        _playerCap = PlayerCap;
        _ruleSetName = RuleSetName;
    }

    private void Cancel() => MudDialog.Cancel();

    private static string? ValidateCap(int? cap) =>
        cap is int value && value < 1 ? "Player cap must be at least 1, or leave it blank." : null;

    private async Task SubmitAsync()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid)
            return;

        MudDialog.Close(DialogResult.Ok(new Result(
            string.IsNullOrWhiteSpace(_title) ? null : _title.Trim(),
            Blank(_host),
            string.IsNullOrWhiteSpace(_notes) ? null : _notes.Trim(),
            HidePlace ? Blank(Venue) : Blank(_venue),
            HidePlace ? Blank(Address) : Blank(_address),
            HidePlace ? Blank(OnlineLink) : Blank(_online),
            HidePlace ? Blank(LocationNotes) : Blank(_locationNotes),
            _playerCap,
            string.IsNullOrWhiteSpace(_ruleSetName) ? null : _ruleSetName.Trim())));
    }

    public sealed record Result(
        string? Title,
        string? HostName,
        string? Notes,
        string? Venue,
        string? Address,
        string? OnlineLink,
        string? LocationNotes,
        int? PlayerCap,
        string? RuleSetName);

    private static string? Blank(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
}
