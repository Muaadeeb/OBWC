<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <!-- The loader imports ./dotnet.js. A fingerprinted name 404s on the hosted site and the spinner never finishes. -->
    <WasmFingerprintDotnetJs>false</WasmFingerprintDotnetJs>
    <!-- A Debug gzip of dotnet.js can stay behind after the boot list changes. The browser then
         requests assemblies that are gone and the integrity checks fail. Release still compresses. -->
    <CompressionEnabled Condition="'$(Configuration)' == 'Debug'">false</CompressionEnabled>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <RootNamespace>OBWC.Client</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.14" PrivateAssets="all" />
    <PackageReference Include="Heron.MudCalendar" Version="4.1.0" />
    <PackageReference Include="MudBlazor" Version="9.12.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OBWC.Shared\OBWC.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="wwwroot/appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
