<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\OBWC.Api.dll" stdoutLogEnabled="true" stdoutLogFile=".\logs\stdout" hostingModel="outofprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
          <!--
            Do not put the SQL password or Jwt__Key in source control.
            Add them on the server, either as more environmentVariable entries
            or in an uncommitted appsettings.Production.json next to OBWC.Api.dll.
            ConnectionStrings__DefaultConnection
            Jwt__Key
            Authorization__SuperAdminEmail
            Smtp__Host, Smtp__UserName, Smtp__Password, Smtp__FromAddress
          -->
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
