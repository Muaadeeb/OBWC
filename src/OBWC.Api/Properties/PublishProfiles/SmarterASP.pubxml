<?xml version="1.0" encoding="utf-8"?>
<!--
This file is used by the publish/package process of your project.
One site hosts the pages and the API, the same way BattleTech does.
The deploy password is saved in SmarterASP.pubxml.user, which is gitignored.
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <WebPublishMethod>MSDeploy</WebPublishMethod>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <SiteUrlToLaunchAfterPublish>https://omahabeachwc.com/</SiteUrlToLaunchAfterPublish>
    <LaunchSiteAfterPublish>true</LaunchSiteAfterPublish>
    <ExcludeApp_Data>true</ExcludeApp_Data>
    <MSDeployServiceURL>win1006.site4now.net:8172</MSDeployServiceURL>
    <DeployIisAppPath>timothyingledue-001-site3</DeployIisAppPath>
    <RemoteSitePhysicalPath />
    <SkipExtraFilesOnServer>true</SkipExtraFilesOnServer>
    <MSDeployPublishMethod>WMSVC</MSDeployPublishMethod>
    <EnableMSDeployBackup>false</EnableMSDeployBackup>
    <EnableMsDeployAppOffline>true</EnableMsDeployAppOffline>
    <UserName>timothyingledue-001</UserName>
    <_SavePWD>true</_SavePWD>
    <TargetFramework>net10.0</TargetFramework>
    <!--
      SmarterASP runs .NET 10 out of process, 32-bit.
      Framework-dependent in-process publish returns HTTP 503 on site3.
    -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <AspNetCoreHostingModel>OutOfProcess</AspNetCoreHostingModel>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <EnvironmentName>Production</EnvironmentName>
    <AllowUntrustedCertificate>true</AllowUntrustedCertificate>
  </PropertyGroup>
  <Target Name="IncludeProductionSettings" BeforeTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Include="$(MSBuildProjectDirectory)\appsettings.Production.json" Condition="Exists('$(MSBuildProjectDirectory)\appsettings.Production.json')">
        <RelativePath>appsettings.Production.json</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
